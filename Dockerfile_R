# Usa uma imagem base que contém o R.
FROM r-base:latest

# Instala o Python e as dependências necessárias para o projeto.
RUN apt-get update && apt-get install -y \
    git \
    python3 \
    python3-pip \
    libxml2-dev \
    libcurl4-openssl-dev \
    libssl-dev

# Instala o pacote IRACE no ambiente R.
RUN R -e "install.packages('irace', repos = 'https://cloud.r-project.org')"

# Define o diretório de trabalho.
WORKDIR /app

# Copia os arquivos do seu projeto para o contêiner.
COPY . /app

# Adiciona permissão de execução ao script de shell
RUN chmod +x exp/validation/run-sa-irace.sh

# Instala as dependências Python a partir do requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

# Define o comando de entrada.
CMD ["bash"]