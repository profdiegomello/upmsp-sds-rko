## OBS.: precisa ficar na raiz do projeto pois o comando COPY do Docker não permite usar ../

# 1) Baixa a imagem base do Python
FROM python:3.13-slim

# 2) Instala git
RUN apt-get update && apt-get install -y git

# 3) Cria diretório de trabalho
WORKDIR /app

# 4.1) Instala as dependências (quando congelar o projeto, gere o requirements.txt)
RUN pip install --no-cache-dir numpy matplotlib pulp gurobipy argparse kaggle
# 4.2) Copia arquivo de dependências Python e as instala (caso haja alguma a mais no requirements.txt)
COPY requirements.txt /app/
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

# 5.1) Instala dependências do sistema e do R
RUN apt-get update && apt-get install -y \
    r-base \
    r-base-dev \
    libxml2-dev \
    libcurl4-openssl-dev \
    libssl-dev
# 5.2) Instala pacote IRACE no R
RUN R -e "install.packages('irace', repos = 'https://cloud.r-project.org')"

# 6) Copia o repositório local (DICA: tudo que for mutável coloque abaixo dos comandos de install, isso evita [re]build demorado)
COPY ./ /app/

# 7.1 Corrige permissão de execução para scripts criados no Windows
RUN chmod +x ./src/irace/*.sh
# 7.2) Configura Kaggle
RUN mkdir -p /root/.config/kaggle && echo '{"username":"everthonvalado","key":"2eb29fb3d6d624834ac906b93bd70650"}' > /root/.config/kaggle/kaggle.json && chmod 600 /root/.config/kaggle/kaggle.json
# RUN mkdir -p /root/.config/kaggle && cp /app/.config/kaggle/kaggle.json /root/.config/kaggle/kaggle.json

# 8) Comando padrão para rodar o código se nenhum outro executável for indicado
# RUN cd /app/src/irace/
# CMD ["Rscript", "./src/irace/irace-sa-scenario.R"]
CMD ["bash"]

