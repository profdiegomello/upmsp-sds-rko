# Imagem base
FROM python:3.13-slim

# Instala dependências do sistema e do R
RUN apt-get update && apt-get install -y \
    r-base \
    r-base-dev \
    git \
    libxml2-dev \
    libcurl4-openssl-dev \
    libssl-dev

# Define diretório de trabalho
WORKDIR /app

# Copia apenas arquivos de dependências primeiro
COPY requirements.txt /app/
# (Se tiver dependências R fixas, crie também um arquivo install_r_packages.R)

# Instala dependências Python
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

# Instala pacote IRACE no R
RUN R -e "install.packages('irace', repos = 'https://cloud.r-project.org')"

# Só agora copia o resto do projeto (evita rebuild desnecessário)
COPY . /app

# Configura Kaggle
RUN mkdir -p /root/.config/kaggle && \
    mv /app/.config/kaggle/kaggle.json /root/.config/kaggle/kaggle.json

# Permissão para script
RUN chmod +x exp/validation/run-sa-irace.sh

# Comando padrão
CMD ["bash"]
